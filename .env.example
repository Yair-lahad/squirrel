# Use the dedicated `squirrel_app` DB role (not the default postgres login) -
# owns the app's tables, with RLS blocking every other role.
DATABASE_URL=postgresql://squirrel_app.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Free-tier key from https://aistudio.google.com/apikey - used to turn an
# uploaded statement document into structured transactions (see
# backend/agents/statementExtractor.js). Defaults to gemini-flash-lite-latest;
# override with GEMINI_MODEL if your key's free-tier quota differs.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
